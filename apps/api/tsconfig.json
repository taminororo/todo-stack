{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,

    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
