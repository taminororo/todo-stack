{
	// JIT パッケージ: ビルドせず、apps 側 (Next / Vitest) が src の .ts を直接読む。
	// ここは型チェック専用なので noEmit
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"lib": ["dom", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src"]
}
